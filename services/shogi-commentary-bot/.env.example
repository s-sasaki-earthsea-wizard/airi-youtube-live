# Log level (log | debug)
LOG_LEVEL=log

# AIRI Server (WebSocket hub) connection
AIRI_SERVER_URL=ws://localhost:6121/ws
AIRI_SERVER_TOKEN=

# Kifu file to commentate (relative to this package directory or absolute)
KIFU_FILE=../shogi-analysis/data/kifu/sample.kif

# Which side the character ("さめ") plays as: 先手 or 後手
# Own moves are narrated as deliberate choices; opponent moves get reactions.
SHOGI_OWN_SIDE=先手

# Interval between moves in milliseconds (gives TTS time to speak)
SHOGI_MOVE_INTERVAL_MS=10000

# Limit number of moves to send (0 = send all moves)
SHOGI_MAX_MOVES=0
