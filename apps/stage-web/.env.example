# LLM Configuration (OpenRouter)
# Get API Key from: https://openrouter.ai/settings/keys
VITE_LLM_PROVIDER=openrouter-ai
VITE_LLM_API_KEY=your-openrouter-api-key-here
VITE_LLM_BASE_URL=https://openrouter.ai/api/v1/
# Free model for development (Llama 3.1 8B - no cost)
# VITE_LLM_MODEL=nousresearch/hermes-3-llama-3.1-405b:free
# Production model (high quality, recommended)
VITE_LLM_MODEL=google/gemini-2.5-flash

# TTS Configuration (OpenAI - more affordable)
VITE_TTS_PROVIDER=openai-audio-speech
VITE_TTS_API_KEY=your-openai-api-key-here
VITE_TTS_BASE_URL=https://api.openai.com/v1
VITE_TTS_MODEL=tts-1
# Available voices: alloy, ash, ballad, coral, echo, fable, onyx, nova, sage, shimmer, verse
VITE_TTS_VOICE_ID=nova

# ElevenLabs configuration (alternative TTS provider)
# VITE_TTS_PROVIDER=elevenlabs
# VITE_TTS_API_KEY=your-elevenlabs-api-key-here
# VITE_TTS_BASE_URL=https://unspeech.hyp3r.link/v1/
# VITE_TTS_MODEL=eleven_v3
# VITE_TTS_VOICE_ID=your-voice-id-here

# Character Configuration
VITE_CHARACTER_NAME=SaMe
VITE_CHARACTER_SYSTEM_PROMPT_PATH=/prompts/system-prompt.md

# Knowledge Database (RAG Support)
# Enable to inject relevant character knowledge into system prompts
VITE_KNOWLEDGE_DB_ENABLED=true
VITE_KNOWLEDGE_DB_URL=http://localhost:3100
# Settings for prompt-based queries (full user question search)
VITE_KNOWLEDGE_DB_LIMIT=5
VITE_KNOWLEDGE_DB_THRESHOLD=0.3

# Idle Talk Feature
# Automatically start conversation when no user input for specified time
# Requires VITE_KNOWLEDGE_DB_ENABLED=true
VITE_IDLE_TALK_ENABLED=false
# Idle timeout in milliseconds (default: 60000ms = 60 seconds)
VITE_IDLE_TIMEOUT=60000
# Topic selection mode: 'random' or 'sequential' (currently only 'random' is supported)
VITE_IDLE_TALK_MODE=random
# Minimum similarity threshold for random topic selection (0-1)
VITE_IDLE_TALK_MIN_SIMILARITY=0.0
# Context continuation: Continue talking about related topics
VITE_IDLE_TALK_CONTINUE_CONTEXT=true
# Maximum number of times to continue the same topic (default: 5)
VITE_IDLE_TALK_MAX_CONTINUATION=3
# Number of recent topics to remember and exclude from future selections (prevents repetition)
VITE_IDLE_TALK_TOPIC_HISTORY_SIZE=5
# Number of random topics to fetch from Knowledge DB (higher = more diversity, but more bandwidth)
VITE_IDLE_TALK_FETCH_LIMIT=10

# Chat Topic Continuation
# Automatically continue conversation topics from user chat inputs
# Requires VITE_KNOWLEDGE_DB_ENABLED=true
VITE_CHAT_CONTINUATION_ENABLED=true
# Maximum number of times to continue user's topic before waiting for new input
VITE_CHAT_MAX_CONTINUATION=3

# Auto Response for External Chat Messages (YouTube, Discord, Telegram)
# Enable automatic AI response generation when receiving messages from external sources
VITE_AUTO_RESPONSE_ENABLED=true

# YouTube Streaming Mode
# Enable streaming-optimized UI for YouTube Live broadcasting
VITE_STREAMING_MODE=true
# Show/hide header with logo and settings button
VITE_SHOW_HEADER=false
# Show/hide LLM responses in chat history (keep user messages visible)
VITE_SHOW_LLM_RESPONSES=false
# Show/hide text input area (during streaming, messages come from YouTube chat)
VITE_SHOW_TEXT_INPUT=true

# Avatar Configuration for OBS/Streaming
# Configure avatar model and position for broadcasting without accessing settings UI
# Available preset models:
#   - preset-live2d-1: Hiyori (Pro)
#   - preset-live2d-2: Hiyori (Free)
#   - preset-vrm-1: AvatarSample_A
#   - preset-vrm-2: AvatarSample_B
VITE_AVATAR_MODEL=preset-vrm-2
# Avatar position (relative to screen center, units are %)
# Positive x moves right, negative x moves left
# Positive y moves down, negative y moves up
VITE_AVATAR_POSITION_X=0.1
VITE_AVATAR_POSITION_Y=-0.2
# Avatar scale (1.0 = 100%, 0.5 = 50%, 2.0 = 200%)
VITE_AVATAR_SCALE=1

# Query Expansion Feature
# Uses LLM to expand user queries into related keywords for better Knowledge DB search
VITE_QUERY_EXPANSION_ENABLED=true
VITE_QUERY_EXPANSION_MODEL=google/gemini-2.0-flash-lite-001

# Expanded Search Settings (keyword-based search)
# These settings are used when searching with expanded keywords
# Note: Keyword queries may have different similarity characteristics than prompt queries
# Maximum number of keywords to generate per query (default: 5, experiment: 10)
VITE_EXPANDED_SEARCH_MAX_KEYWORDS=10
# Maximum number of results per keyword search (default: 5, experiment: 10)
VITE_EXPANDED_SEARCH_LIMIT=10
# Minimum similarity threshold for keyword searches (0-1, default: 0.4, experiment: 0.25)
# Lower threshold = more candidates for LLM reranking
VITE_EXPANDED_SEARCH_THRESHOLD=0.25

# LLM Reranking Settings
# Use LLM to select the most relevant results from candidates
# Solves the "Hokuto no Ken problem" where high-similarity but irrelevant results rank higher
VITE_RERANKING_ENABLED=true
# Number of final results to select after reranking (default: 10)
VITE_RERANKING_TOP_K=10
